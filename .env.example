# Backend environment variables (also loaded by docker-compose via env_file)

# dev | prod | test — 'prod' enables secure/sameSite=none cookies and trust proxy
NODE_ENV=dev
PORT=3000

# Mongo connection string — also backs the session store
MONGODB_URI=mongodb://mongo:27017/spotify

# Spotify app credentials — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the redirect URI registered in the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# Random string used to sign the session cookie
SPOTIFY_SESSION_SECRET=

# Where the frontend is served: CORS origin and post-login redirect target
FRONTEND_URL=http://127.0.0.1:5173

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Read by SpotifyStrategy (passport), which is registered but not used by any
# route today. Left out of the Joi schema on purpose — see the report.
# SPOTIFY_CALLBACK_URL=
