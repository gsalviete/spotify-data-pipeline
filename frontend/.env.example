# Frontend environment variables (vite)

# Base URL of the deployed backend, e.g. https://spotify-api.onrender.com
# Leave empty in dev: requests fall back to '/api' and the vite dev proxy
# forwards them to the backend.
VITE_API_BASE_URL=

# Dev proxy target used by vite.config.ts (defaults to http://backend:3000)
VITE_API_URL=http://127.0.0.1:3000
